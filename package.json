{
  "name": "vault-backend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "services/*"
  ],
  "devDependencies": {
    "eslint": "^8.50.0",
    "husky": "^9.1.7",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "prepare": "husky",
    "gitleaks": "bash scripts/run-gitleaks.sh",
    "gitleaks:staged": "bash scripts/gitleaks-pre-commit.sh",
    "install:all": "pnpm install",
    "clean": "pnpm store prune && rm -rf node_modules **/node_modules",
    "build:all": "pnpm -r run build",
    "dev:all": "pnpm -r --parallel run dev",
    "start:all": "pnpm -r --parallel run start",
    "start:vault": "pnpm --filter vault-service run dev",
    "start:mobile_vault": "pnpm --filter mobile-vault-service run dev",
    "start:core": "pnpm --filter core-service run dev",
    "stop:core": "pnpm --filter core-service run stop",
    "start:admin": "pnpm --filter admin-app-service run dev",
    "stop:admin": "pnpm --filter admin-app-service run stop",
    "build:admin": "pnpm --filter admin-app-service run build",
    "start:playground": "pnpm --filter api-playground-service run dev",
    "stop:playground": "pnpm --filter api-playground-service run stop",
    "start:gateway": "pnpm --filter gateway-service run dev",
    "start:auth": "pnpm --filter auth-service run dev",
    "start:notification": "pnpm --filter notification-service run dev",
    "start:file": "pnpm --filter file-service run dev",
    "start:scheduler": "node scripts/start-scheduler.js",
    "build:vault": "pnpm --filter vault-service run build",
    "build:mobile_vault": "pnpm --filter mobile-vault-service run build",
    "build:core": "pnpm --filter core-service run build",
    "build:playground": "pnpm --filter api-playground-service run build",
    "build:gateway": "pnpm --filter gateway-service run build",
    "build:auth": "pnpm --filter auth-service run build",
    "build:notification": "pnpm --filter notification-service run build",
    "build:file": "pnpm --filter file-service run build",
    "build:scheduler": "pnpm --filter vault-scheduler-service run build"
  },
  "dependencies": {
    
  },
  "pnpm": {
    "overrides": {
      "core-service>bson": "6.10.4",
      "core-service>mongodb": "6.20.0",
      "jws@3.2.2": "3.2.3",
      "jws@4.0.0": "4.0.1",
      "path-to-regexp@0.1.12": "0.1.13",
      "multer@2.0.2": "2.2.0"
    }
  }
}