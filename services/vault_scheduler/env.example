# ============================================
# VAULT SCHEDULER - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# --------------------------------------------
# Redis Configuration
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --------------------------------------------
# MongoDB Configuration
# --------------------------------------------
# Option 1: Use individual components (same as vault service)
VAULT_DB_USERNAME=your-mongodb-username
VAULT_DB_PASSWORD=your-mongodb-password
VAULT_DB_HOST=your-mongodb-cluster.mongodb.net
VAULT_DB_NAME=vault

# Option 2: Use full MongoDB URI (alternative)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vault?retryWrites=true&w=majority
# MONGODB_DATABASE=vault

# --------------------------------------------
# Job Configuration
# --------------------------------------------
# Soft Delete Cleanup Job
SOFT_DELETE_CLEANUP_ENABLED=true
SOFT_DELETE_CLEANUP_INTERVAL=0 * * * *
SOFT_DELETE_RETENTION_DAYS=30

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_LEVEL=info

