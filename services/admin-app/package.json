{
  "name": "admin-app-service",
  "version": "1.1.2",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "predev": "pnpm --filter @novasafe/feature-flags run build && node ../../scripts/free-port.mjs ADMIN_PORT 3130",
    "dev": "tsx watch src/index.ts",
    "build": "pnpm --filter @novasafe/feature-flags run build && REPOSITORY=novasafe-admin-api node ../../scripts/generate-build-metadata.mjs --package services/admin-app/package.json --out services/admin-app/src/generated && tsc -p tsconfig.json && tsc-alias -p tsconfig.json && REPOSITORY=novasafe-admin-api node ../../scripts/generate-build-metadata.mjs --package services/admin-app/package.json --out services/admin-app/dist",
    "start": "node dist/index.js",
    "build:lambda": "tsc -p tsconfig.lambda.json && tsc-alias -p tsconfig.lambda.json",
    "stop": "node ../../scripts/free-port.mjs ADMIN_PORT 3130",
    "seed": "tsx src/scripts/seed-admin.ts",
    "pretest": "pnpm --filter @novasafe/feature-flags run build",
    "test": "node ../../scripts/run-node-tests.mjs ."
  },
  "dependencies": {
    "@codegenie/serverless-express": "^5.0.0",
    "@hono/node-server": "^1.14.0",
    "@novasafe/feature-flags": "workspace:*",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "hono": "^4.13.5",
    "jose": "^5.10.0",
    "mongodb": "6.20.0",
    "multer": "^2.2.0",
    "resend": "^4.0.0",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2"
  }
}
