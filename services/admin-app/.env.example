# Admin API (novasafe-admin-panel backend)
NODE_ENV=development
ADMIN_PORT=3130
BIND_HOST=0.0.0.0

# MongoDB (shared cluster — RBAC, changelog, blog, vault customer data)
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_HOST=
DATABASE_NAME=novasafe

# JWT for admin panel sessions (blog module reuses this — no separate JWT_SECRET needed)
ADMIN_JWT_SECRET=change-me-in-production-min-32-chars
ADMIN_JWT_EXPIRES_IN=7d

# Bootstrap owner (seed script only)
ADMIN_OWNER_EMAIL=owner@novasafe.io
ADMIN_OWNER_PASSWORD=Owner@123
ADMIN_OWNER_NAME=Nova Operator

# Core API — status admin proxy (public status stays on core)
CORE_API_URL=http://localhost:3125
STATUS_PAGE_ADMIN_SECRET=

# Blog media storage
MEDIA_STORAGE_PATH=./uploads
PUBLIC_SITE_URL=https://novasafe.io

# CORS — admin panel UI origins only (landing uses core blog proxy, not admin-api)
ADMIN_CORS_ORIGINS=https://admin.novasafe.io,https://ns-admin.netlify.app,http://localhost:5173

# Full URL for invite + password reset links in emails
ADMIN_PANEL_URL=https://admin.novasafe.io

# Transactional email via Resend (same as core service)
RESEND_API_KEY=
RESEND_FROM=no-reply@novasafe.io
