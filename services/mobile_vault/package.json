{
  "name": "mobile-vault-service",
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node dist/src/index.js",
    "build": "tsc",
    "dev": "ts-node-dev --require tsconfig-paths/register src/index.ts",
    "test": "node --require ts-node/register/transpile-only --test src/subscription/*.test.ts",
    "migrate:trusted-devices": "ts-node --require tsconfig-paths/register src/migrations/seed-trusted-devices.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "google-auth-library": "^10.6.2",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^5.9.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.2",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
