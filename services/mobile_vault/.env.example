# Copy to `.env` and adjust. See main server docs for full variable list.

# --- In-app update manifest (`GET /mobile/app/version`) ---
# Semver-like string compared to the app’s `versionName` (from @capacitor/app).
# If unset, the API returns `0.0.0` so clients never treat the app as outdated.
MOBILE_APP_LATEST_VERSION=0.0.0
# Set to `true` to require update (client shows blocking screen + store).
MOBILE_APP_FORCE_UPDATE=false
# Optional copy for optional update modal (backend-driven).
MOBILE_APP_UPDATE_MESSAGE=New features available

# Alias supported in code:
# APP_LATEST_VERSION=1.2.0

# --- Google OAuth verification ---
# Must match Google OAuth client IDs used by the mobile/web app.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# --- Sign in with Apple (identity token verification) ---
# JWT `aud` must match the iOS app bundle id used by the native app.
APPLE_IOS_BUNDLE_ID=io.novasafe.mobile
# Optional extra audience (e.g. Services ID) if you add web Sign in with Apple later.
# APPLE_SIGNIN_AUDIENCE=

# --- RevenueCat (subscriptions / auto-renewal) ---
# Secret API key (sk_...) — required for GET /subscribers sync and offerings.
REVENUECAT_API_KEY=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_API_BASE_URL=https://api.revenuecat.com/v1
REVENUECAT_ENTITLEMENT_PRO=pro
REVENUECAT_DEFAULT_OFFERING_ID=default
# Authorization header value from RevenueCat → Integrations → Webhooks (same string you configure in dashboard).
REVENUECAT_WEBHOOK_SECRET=
# Public webhook route (configure manually in RevenueCat dashboard):
#   POST https://YOUR_HOST/mobile/subscriptions/webhook/revenuecat
# Handled events: INITIAL_PURCHASE, RENEWAL, CANCELLATION, EXPIRATION, BILLING_ISSUE,
# UNCANCELLATION, PRODUCT_CHANGE (+ additional types logged and synced via RevenueCat REST).
FREE_PLAN_MAX_PASSWORDS=15
FREE_PLAN_MAX_SECURE_NOTES=5
FREE_PLAN_MAX_DEVICES=1
# Production: false. Development defaults to relaxed limits unless explicitly false.
SUBSCRIPTION_RELAX_DEVICE_LIMITS=false
SUBSCRIPTION_EMAIL_FROM=no-reply@novasafe.io
# Optional: protect GET /mobile/subscriptions/debug
SUBSCRIPTION_DEBUG_KEY=
