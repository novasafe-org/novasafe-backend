{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "@common/*": ["../../common/*"],
      "config/*": ["./config/*"],
      "database/*": ["./database/*"],
      "src/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "config/**/*", "database/**/*"],
  "exclude": ["node_modules", "dist"]
}