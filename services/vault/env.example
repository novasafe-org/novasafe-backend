# ============================================
# VAULT BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# --------------------------------------------
# Server Configuration
# --------------------------------------------
PORT=5001

# --------------------------------------------
# Google OAuth Configuration
# --------------------------------------------
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing one
# 3. Enable Google+ API
# 4. Go to "Credentials" → "Create Credentials" → "OAuth 2.0 Client ID"
# 5. Choose "Web application"
# 6. Add authorized JavaScript origins (e.g., http://localhost:5173)
# 7. Copy the Client ID here

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SECURITY NOTE:
# - The Client ID is public and can be exposed in frontend code
# - NEVER expose your Client Secret in frontend code
# - For this implementation, we only need the Client ID

# --------------------------------------------
# JWT Configuration
# --------------------------------------------
# JWT_SECRET is used to sign and verify JWT tokens
# CRITICAL SECURITY REQUIREMENTS:
# - Must be a strong, random string (at least 32 characters)
# - Keep this SECRET and NEVER commit it to version control
# - Use different secrets for development/staging/production
# - Change it immediately if compromised (will invalidate all tokens)
#
# Generate a strong secret using one of these methods:
# - Node.js: require('crypto').randomBytes(64).toString('hex')
# - OpenSSL: openssl rand -base64 64
# - Online: https://www.grc.com/passwords.htm

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-at-least-32-characters

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# MongoDB database name
VAULT_DB_NAME=vault

# NOTES:
# - MongoDB URI is configured in config/config.ts
# - Consider moving it to .env for better security:
#   MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# --------------------------------------------
# PayU Payment Gateway Configuration
# --------------------------------------------
# Get these from PayU Merchant Dashboard:
# 1. Go to https://dashboard.payu.in/
# 2. Login to your merchant account
# 3. Go to Settings → API Credentials
# 4. Copy Merchant ID, Merchant Key, and Merchant Salt

PAYU_MERCHANT_ID=your_payu_merchant_id
PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_MERCHANT_SALT=your_payu_merchant_salt

# PayU API URLs (usually don't need to change)
PAYU_BASE_URL=https://secure.payu.in
PAYU_API_URL=https://secure.payu.in/api/v2

# Environment: 'sandbox' for testing, 'production' for live
PAYU_ENVIRONMENT=sandbox

# Enable recurring payments (true/false)
PAYU_ENABLE_RECURRING=true

# Payment callback URLs (update with your domain)
PAYU_SUCCESS_URL=https://novasafe.app/payment/success
PAYU_FAILURE_URL=https://novasafe.app/payment/failure

# Payment timeout in seconds (default: 1800 = 30 minutes)
PAYU_PAYMENT_TIMEOUT=1800

# Order expiry in minutes (default: 30 minutes)
PAYU_ORDER_EXPIRY_MINUTES=30

# --------------------------------------------
# Email (SMTP) Configuration
# --------------------------------------------
# Required for sending invitation emails, OTP emails, and notifications
# 
# For Gmail:
# 1. Enable "Less secure app access" OR use App Password
# 2. Go to Google Account → Security → 2-Step Verification → App passwords
# 3. Generate an app password and use it as SMTP_PASSWORD
# 
# For other email providers, check their SMTP settings:
# - Gmail: smtp.gmail.com, port 587 (TLS) or 465 (SSL)
# - Outlook: smtp-mail.outlook.com, port 587
# - SendGrid: smtp.sendgrid.net, port 587
# - AWS SES: Check AWS SES documentation

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-or-email-password
SMTP_FROM=noreply@novasafe.com

# Alternative Gmail SMTP settings (if port 587 is blocked):
# SMTP_PORT=465
# SMTP_SECURE=true

# Main app URL (for redirects, CORS, etc.). Dev: app on 3063; prod: https://app.novasafe.io
FRONTEND_URL=http://localhost:3063

# LOCAL DEV ONLY: When set, post-login redirects go to this origin (e.g. http://localhost:3063/vault).
# In PRODUCTION leave APP_ORIGIN unset so Team/Business users are redirected to their company subdomain (e.g. https://abc.novasafe.io/vault).
# If APP_ORIGIN is set in prod, all users get redirected to that single origin and company subdomains will not work.
# APP_ORIGIN=

# Multi-tenant redirects (used when APP_ORIGIN is not set): base domain and subdomain for Individual/Family.
BASE_DOMAIN=novasafe.io
INDIVIDUAL_SUBDOMAIN=app
VAULT_PATH=/vault
PROTOCOL=https

# Auth/start app URL for invitation acceptance and onboarding links. Dev: auth app on 3061; prod: https://start.novasafe.io
AUTH_APP_URL=http://localhost:3061

