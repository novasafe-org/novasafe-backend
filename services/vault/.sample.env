# Development Environment Variables for Vault Service

# MongoDB Configuration - Alternative URI format for OpenSSL 3.x compatibility
VAULT_DB_URI=mongodb+srv://vaultatlasdbuser:TGExCm3gURQg7mvg@vault-cluster.chu49ca.mongodb.net/vault?retryWrites=true&w=majority
VAULT_DB_NAME=vault

# Server Configuration  
NODE_ENV=development
PORT=5001

# OpenSSL compatibility
NODE_OPTIONS=--openssl-legacy-provider

# Logging
LOG_LEVEL=debug

# Security - Server Master Key for encrypting 2FA secrets
