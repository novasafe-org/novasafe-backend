# IMPORTANT: Keep this secret and never commit it to version control!
# In production, use a secrets manager (AWS Secrets Manager, Azure Key Vault, etc.)
SERVER_MASTER_KEY=88d9ce5519f168fb36bcdea59feeb5eaeb67d08f74cdd322556f7b07b91bb3f8