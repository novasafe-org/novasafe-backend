{
  "name": "vault-service",
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node dist/src/index.js",
    "build": "tsc",
    "dev": "ts-node-dev --require tsconfig-paths/register src/index.ts",
    "migrate:schema": "ts-node --require tsconfig-paths/register migrations/001-complete-schema-setup.ts",
    "migrate:indexes": "ts-node --require tsconfig-paths/register migrations/002-setup-indexes.ts",
    "migrate:all": "npm run migrate:schema && npm run migrate:indexes"
  },
  "dependencies": {
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "google-auth-library": "^9.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^5.9.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.2",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.3",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/speakeasy": "^2.0.9",
    "@types/qrcode": "^1.5.5",
    "@types/bcryptjs": "^2.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "tsconfig-paths": "^4.2.0"
  }
}