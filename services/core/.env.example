# =============================================================================
# NovaSafe Core API — environment template
# =============================================================================
#
# HOW TO USE
#   1. Copy this file:  cp .env.example .env
#   2. Fill in REQUIRED values (marked below).
#   3. Start the service:  pnpm run start:core  (from repo root)
#
# NOTES
#   - Never commit `.env` (secrets). Only commit this `.env.example`.
#   - Boolean env vars: use true | false (also accepted: 1, yes, on).
#   - Empty optional values are OK; features stay disabled until set.
#
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — minimum to run locally
# -----------------------------------------------------------------------------

# Shared secret for signing JWT access tokens (must match legacy mobile_vault if sharing sessions).
# Generate a long random string for production. App will refuse to start if empty.
JWT_SECRET=change-me-use-a-long-random-string

# MongoDB — local OR Atlas (same as mobile_vault when migrating).
#
# Option A — full URI (overrides everything below):
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/vault?retryWrites=true&w=majority
#
# Option B — local dev:
# MONGO_URI=mongodb://127.0.0.1:27017/novasafe_core
#
# Option C — Atlas via parts (matches mobile_vault .env):
MONGO_DB_NAME=vault
MONGO_HOST=your-cluster.mongodb.net
MONGO_USER=your-atlas-user
MONGO_PASSWORD=your-atlas-password
#
# Option D — mobile_vault variable names (aliases; same DB as vault service):
# VAULT_DB_NAME=vault
# VAULT_DB_HOST=your-cluster.mongodb.net
# VAULT_DB_USERNAME=your-atlas-user
# VAULT_DB_PASSWORD=your-atlas-password


# -----------------------------------------------------------------------------
# APP / RUNTIME (optional — sensible defaults)
# -----------------------------------------------------------------------------

# Runtime mode: development | staging | production | test
# Affects logging defaults (console vs file, JSON vs pretty).
NODE_ENV=development

# HTTP port for Core API (default 3125). Also accepts PORT if CORE_PORT is unset.
CORE_PORT=3125

# Network interface to bind (0.0.0.0 = all interfaces; 127.0.0.1 = localhost only).
BIND_HOST=0.0.0.0


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Tip: set LOG_LEVEL=http to see every HTTP request line in the terminal (POST /api/v1/... 401, etc.).
# At LOG_LEVEL=info, request access logs (level "http") are hidden; app/info/error logs still show.

# Minimum log level: error | warn | success | info | http | verbose | debug | audit
LOG_LEVEL=info

# Label shown in log output.
LOG_SERVICE_NAME=novasafe-core

# --- Where logs go ---
# development default: console ON, file OFF
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_FILE=false

# split = combined + error files | single = one app log file (typical in Docker)
LOG_FILE_MODE=split

# Directory for rotated log files (relative to cwd, or /app/logs in containers).
LOG_DIR=logs

# Force container-style logging (file-only, no colors) even outside Docker.
# LOG_CONTAINER_MODE=true

# --- What to log ---
# Log each finished HTTP request (method, path, status, duration). Uses log level "http".
LOG_ENABLE_REQUEST=true

# Include stack traces on errors.
LOG_ENABLE_ERROR_STACK=true

# Log request/response JSON bodies (passwords/tokens redacted via LOG_SENSITIVE_FIELDS).
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# Comma-separated field names to redact in body logs.
LOG_SENSITIVE_FIELDS=password,token,authorization,secret,apiKey,refreshToken

# --- Log appearance (development) ---
LOG_ENABLE_COLORS=true
LOG_PRETTY_PRINT=true
LOG_JSON_FORMAT=false
# Pretty ANSI console in dev; set true in containers for stdout JSON (no colors)
LOG_CONSOLE_STRUCTURED=false
# Comma-separated context fields on every log (see log-context-fields.config.ts)
# LOG_CONTEXT_FIELDS=requestId,traceId,source,platform,userId
# Comma-separated fields on HTTP access logs
# LOG_HTTP_FIELDS=requestId,method,url,statusCode,durationMs,ip
# Extra JSON block under console lines (off by default)
LOG_CONSOLE_META=false
# Stack traces on console (file logs use LOG_ENABLE_ERROR_STACK)
LOG_CONSOLE_ERROR_STACK=false

# --- File rotation (when LOG_ENABLE_FILE=true) ---
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
LOG_DATE_PATTERN=YYYY-MM-DD

# --- Production / Docker preset (uncomment instead of dev block above) ---
# NODE_ENV=production
# LOG_ENABLE_CONSOLE=false
# LOG_ENABLE_FILE=true
# LOG_FILE_MODE=single
# LOG_DIR=/app/logs
# LOG_JSON_FORMAT=true
# LOG_PRETTY_PRINT=false
# LOG_ENABLE_COLORS=false


# -----------------------------------------------------------------------------
# AUTH — JWT, OAuth, email (optional per feature)
# -----------------------------------------------------------------------------
# JWT issuer/audience and expiry are fixed in code (vault-backend / 7d) for mobile_vault compatibility.

# Google Sign-In: OAuth client IDs from Google Cloud Console (Web + Android).
# Leave blank to disable Google OAuth until configured.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Aliases sometimes used by frontends (optional; same values as above).
# VITE_GOOGLE_WEB_CLIENT_ID=
# VITE_GOOGLE_ANDROID_CLIENT_ID=

# Apple Sign In: iOS bundle ID and/or explicit audience string from Apple Developer.
APPLE_IOS_BUNDLE_ID=
APPLE_SIGNIN_AUDIENCE=
# IOS_BUNDLE_IDENTIFIER=

# Transactional email via Resend (OTP, 2FA, onboarding). Leave RESEND_API_KEY empty to disable sending.
RESEND_API_KEY=
RESEND_FROM=no-reply@novasafe.io
# SMTP_FROM=
# SUBSCRIPTION_EMAIL_FROM=

# Free-tier limits per user.
FREE_PLAN_MAX_DEVICES=1
# Development / sandbox: do not block login when Pro expires (RevenueCat 5-min renewals).
# Production should set false — device trust still allows existing trusted devices when false.
SUBSCRIPTION_RELAX_DEVICE_LIMITS=true
FREE_PLAN_MAX_PASSWORDS=15
FREE_PLAN_MAX_SECURE_NOTES=5

# Vault field encryption (must match mobile_vault for shared database).
MOBILE_VAULT_MASTER_KEY=change-me-match-mobile-vault
SERVER_MASTER_KEY=


# -----------------------------------------------------------------------------
# TRUST / CLIENT VERIFICATION (optional — on by default, non-blocking)
# -----------------------------------------------------------------------------
# Validates x-client-source, signatures, replay. Does not block requests unless TRUST_ENFORCE_BLOCKING=true.

# Master switch for trust layer (false = fully off).
TRUST_LAYER_ENABLED=true

# When true, blocked trust level returns 403. Default false = log/enrich only.
TRUST_ENFORCE_BLOCKING=false

# HMAC signature verification (requires client secrets in registry).
TRUST_SIGNATURE_ENABLED=false

# Reject replayed requests (nonce + timestamp window).
TRUST_REPLAY_ENABLED=true
TRUST_REPLAY_WINDOW_MS=300000
TRUST_NONCE_TTL_MS=600000

# Shared Redis for nonce store across instances (optional; in-memory if unset).
# TRUST_REDIS_URL=redis://127.0.0.1:6379

# Registered clients JSON array. Each entry: clientId, allowedSources, secretEnv (env var name for HMAC secret).
# TRUST_CLIENT_REGISTRY=[{"clientId":"novasafe-mobile-ios","allowedSources":["MOBILE_IOS"],"secretEnv":"TRUST_SECRET_MOBILE_IOS"}]
# TRUST_SECRET_MOBILE_IOS=generate-a-strong-secret


# -----------------------------------------------------------------------------
# MONGODB (optional — only if not using MONGO_URI alone)
# -----------------------------------------------------------------------------
# Priority: MONGO_URI > MONGO_* parts > VAULT_DB_* parts (mobile_vault names).
# For shared production data with mobile_vault, use database name `vault` on Atlas.

MONGO_DB_NAME=vault
MONGO_HOST=127.0.0.1:27017
MONGO_USER=
MONGO_PASSWORD=

# mobile_vault-compatible aliases (optional — used when MONGO_* are unset)
# VAULT_DB_NAME=vault
# VAULT_DB_HOST=your-cluster.mongodb.net
# VAULT_DB_USERNAME=
# VAULT_DB_PASSWORD=
# VAULT_DB_PORT=27017

# Connection pool and startup retry.
MONGO_POOL_SIZE=10
MONGO_TIMEOUT=10000
MONGO_RETRY_ATTEMPTS=5
MONGO_RETRY_DELAY=2000


# -----------------------------------------------------------------------------
# REVENUECAT / SUBSCRIPTIONS (optional)
# -----------------------------------------------------------------------------
# REVENUECAT_WEBHOOK_SECRET=
# REVENUECAT_SECRET_API_KEY=
# REVENUECAT_PROJECT_ID=
# REVENUECAT_ENTITLEMENT_PRO=pro
# REVENUECAT_DEFAULT_OFFERING_ID=default
# SUBSCRIPTION_DEBUG_KEY=

# -----------------------------------------------------------------------------
# MOBILE APP VERSION (public /mobile/app/version)
# -----------------------------------------------------------------------------
# MOBILE_APP_LATEST_VERSION=1.0.0
# MOBILE_APP_FORCE_UPDATE=false
# MOBILE_APP_UPDATE_MESSAGE=New features available

# -----------------------------------------------------------------------------
# FUTURE / NOT WIRED IN CORE YET
# -----------------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379
