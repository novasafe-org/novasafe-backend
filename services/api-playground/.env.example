NODE_ENV=development
PLAYGROUND_PORT=5200
BIND_HOST=0.0.0.0

# Security — playground off in production unless explicitly enabled
PLAYGROUND_ENABLED=true
PLAYGROUND_REQUIRE_API_KEY=false
PLAYGROUND_API_KEY=dev-playground-key-change-me

# Core API target (default environment)
CORE_API_URL=http://127.0.0.1:3125
CORE_OPENAPI_URL=http://127.0.0.1:3125/api/v1/openapi.json

# Predefined environments (JSON)
PLAYGROUND_ENVIRONMENTS=[{"id":"local","name":"Local","coreUrl":"http://127.0.0.1:3125"},{"id":"development","name":"Development","coreUrl":"http://127.0.0.1:3125"}]

LOG_LEVEL=info
DATA_DIR=./data
