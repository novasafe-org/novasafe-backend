							"host": [
								"{{base_url}}"
							],
							"path": [
								"v",
								"getAll"
							],
							"query": [
								{
									"key": "category",
									"value": "password",
									"description": "Filter by category (optional)"
								},
								{
									"key": "search",
									"value": "gmail",
									"description": "Search in title, username, notes (optional)"
								},
								{
									"key": "tags",
									"value": "email,google",
									"description": "Filter by tags, comma-separated (optional)"
								}
							]
						},
						"description": "Get all vault items for authenticated user.\n\n**Query Parameters (all optional):**\n- `category`: Filter by category\n- `search`: Search in title, username, notes\n- `tags`: Filter by tags (comma-separated)"
