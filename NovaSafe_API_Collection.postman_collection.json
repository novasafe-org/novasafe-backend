						"body": {
							"mode": "raw",
							"raw": "{\n  \"recipientEmail\": \"recipient@example.com\",\n  \"shareType\": \"item\",\n  \"resourceId\": \"{{item_id}}\",\n  \"permission\": \"view\",\n  \"wrappedKey\": \"base64_encoded_rsa_encrypted_key\",\n  \"wrappedKeyIV\": \"base64_encoded_12_byte_iv\",\n  \"message\": \"Optional message to recipient\",\n  \"integrityHash\": \"base64_encoded_sha256_hash\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/v/share/create",
