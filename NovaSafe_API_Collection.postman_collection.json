					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    if (response.share && response.share.id) {",
									"        pm.environment.set('share_id', response.share.id);",
									"        console.log('Share ID saved to environment:', response.share.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
